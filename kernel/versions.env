# Pins for the Landlock-enabled Kata guest kernel, sourced by build.sh and
# verify-config.sh. See README.md ("Update") before editing.

# Kata release whose kernel recipe is reused. Keep equal to KATA_CHART_VERSION
# in infra/install-kata.sh.
KATA_VERSION=3.27.0
# Commit the tag above must resolve to.
KATA_COMMIT=855f4dc7fac1a4822938212f447413d2a9416bd1

# Must equal assets.kernel.version in that release's versions.yaml and
# tools/packaging/kernel/kata_config_version. build.sh checks both.
KERNEL_VERSION=6.18.12
KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/
KATA_CONFIG_VERSION=181

# Must equal CONFIG_LOCALVERSION in fragments/landlock.conf.
LOCALVERSION=-landlock
