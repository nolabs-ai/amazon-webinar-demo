#!/usr/bin/env bash
# Runs INSIDE the nono sandbox, as the command of `nono run` (see run-demo).
#
# Pi has no flag for a provider's base URL and reads none from the environment,
# but the base URL of nono's credential proxy only exists once the sandbox is up
# (LLM_BASE_URL, a random loopback port). So this wrapper writes Pi's models.json
# from the environment and then execs Pi. The API key in it is the literal
# "${LLM_API_KEY}", which Pi expands to nono's placeholder; the real key never
# enters the sandbox.
#
#   pi-agent <prompt>
#
# Environment (set by the profile and run-demo): AGENT_COMMAND MODEL_PROVIDER
# MODEL_ID MODEL_API LLM_BASE_URL LLM_API_KEY PI_CODING_AGENT_DIR.
set -euo pipefail

: "${AGENT_COMMAND:?}" "${MODEL_PROVIDER:?}" "${MODEL_ID:?}"
: "${PI_CODING_AGENT_DIR:?}"

mkdir -p "$PI_CODING_AGENT_DIR"
if [[ ${MODEL_AUTH:-api-key} == api-key ]]; then
  : "${LLM_BASE_URL:?not set: nono did not start the model credential proxy}"
  : "${LLM_API_KEY:?not set: nono did not load the model-api-key credential}"
  jq -n --arg provider "$MODEL_PROVIDER" --arg api "${MODEL_API:-anthropic-messages}" \
    --arg base "$LLM_BASE_URL" --arg model "$MODEL_ID" '
    {providers: {($provider): {
      baseUrl: $base, api: $api, apiKey: "${LLM_API_KEY}", models: [{id: $model}]
    }}}' >"$PI_CODING_AGENT_DIR/models.json"
fi

# One-shot and reproducible: JSONL events on stdout, no session files, nothing
# loaded from the (untrusted) repository, no update or catalog traffic, and no
# login prompt because the key is already configured.
exec "$AGENT_COMMAND" --mode json \
  --provider "$MODEL_PROVIDER" --model "$MODEL_ID" \
  --no-session --no-context-files --no-extensions --no-skills \
  --no-prompt-templates --no-themes --no-approve --offline -- "$@"
