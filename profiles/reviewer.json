{
  "meta": {
    "name": "webinar-reviewer",
    "version": "0.1.0",
    "description": "Linux policy scaffold for the webinar reviewer agent"
  },
  "workdir": {
    "access": "read"
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "filesystem": {
    "allow": [
      "$HOME/.pi/reviewer"
    ],
    "read_file": [
      "/demo/bin/pi-agent"
    ]
  },
  "network": {
    "allow_domain": [
      "nono-deny-all.invalid"
    ],
    "credentials": [
      "llm"
    ],
    "custom_credentials": {
      "llm": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "file:///run/secrets/github/model-api-key",
        "env_var": "LLM_API_KEY",
        "inject_header": "x-api-key",
        "credential_format": "{}",
        "endpoint_rules": [
          {
            "method": "POST",
            "path": "/v1/messages"
          },
          {
            "method": "POST",
            "path": "/v1/messages/count_tokens"
          }
        ]
      }
    }
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "LANG",
      "LC_*",
      "TERM",
      "AGENT_COMMAND",
      "MODEL_PROVIDER",
      "MODEL_ID",
      "MODEL_API"
    ],
    "set_vars": {
      "PI_CODING_AGENT_DIR": "$HOME/.pi/reviewer",
      "PI_OFFLINE": "1",
      "PI_SKIP_VERSION_CHECK": "1",
      "PI_TELEMETRY": "0"
    }
  },
  "command_policies": {
    "credentials": {
      "github-api": {
        "type": "proxy",
        "upstream": "https://api.github.com",
        "credential_key": "file:///run/secrets/github/token",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    },
    "commands": {
      "git": {
        "executable": "/usr/bin/git",
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                ".",
                "/usr/lib/git-core"
              ],
              "fs_read_file": [
                "/usr/bin/git",
                "@git:config-files"
              ],
              "exec_paths": [
                "/usr/lib/git-core"
              ],
              "environment": {
                "allow_vars": [
                  "PATH",
                  "HOME",
                  "LANG",
                  "LC_*",
                  "TERM"
                ]
              }
            },
            "invocation_policy": {
              "default": "deny",
              "deny": [
                {
                  "argv": {
                    "prefix": [
                      "branch"
                    ]
                  },
                  "reason": "the reviewer may not create or change branches"
                },
                {
                  "argv": {
                    "prefix": [
                      "switch"
                    ]
                  },
                  "reason": "the reviewer may not switch branches"
                },
                {
                  "argv": {
                    "prefix": [
                      "checkout"
                    ]
                  },
                  "reason": "the reviewer may not check out branches"
                },
                {
                  "argv": {
                    "prefix": [
                      "commit"
                    ]
                  },
                  "reason": "the reviewer may not commit changes"
                },
                {
                  "argv": {
                    "prefix": [
                      "push"
                    ]
                  },
                  "reason": "the reviewer may not push code"
                }
              ],
              "allow": [
                {
                  "argv": {
                    "prefix": [
                      "status"
                    ]
                  }
                },
                {
                  "argv": {
                    "prefix": [
                      "diff"
                    ]
                  }
                },
                {
                  "argv": {
                    "prefix": [
                      "log"
                    ]
                  }
                },
                {
                  "argv": {
                    "prefix": [
                      "show"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "ssh": {
        "executable": "/usr/bin/ssh",
        "from": {
          "session": "deny"
        }
      },
      "gh": {
        "executable": "/usr/bin/gh",
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                "."
              ],
              "fs_write": [
                "/tmp"
              ],
              "fs_read_file": [
                "/usr/bin/gh"
              ],
              "credentials": [
                {
                  "name": "github-api",
                  "endpoint_policy": {
                    "default": "deny",
                    "deny": [
                      {
                        "method": "PUT",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/pulls/*/merge",
                        "reason": "the reviewer may not merge pull requests"
                      },
                      {
                        "method": "PATCH",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/issues/**",
                        "reason": "the reviewer may not change issue or pull request state"
                      },
                      {
                        "method": "DELETE",
                        "path": "/**",
                        "reason": "the reviewer may not delete GitHub resources"
                      },
                      {
                        "method": "*",
                        "path": "/graphql",
                        "reason": "the reviewer may not use GraphQL: nono cannot restrict its operations, so a mutation could merge"
                      }
                    ],
                    "allow": [
                      {
                        "method": "GET",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/issues/**"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/pulls/**"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/commits/**"
                      },
                      {
                        "method": "POST",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/issues/*/comments"
                      }
                    ]
                  }
                }
              ],
              "environment": {
                "allow_vars": [
                  "PATH",
                  "HOME",
                  "LANG",
                  "LC_*",
                  "TERM",
                  "GH_TOKEN",
                  "HTTP_PROXY",
                  "HTTPS_PROXY",
                  "NO_PROXY",
                  "http_proxy",
                  "https_proxy",
                  "no_proxy",
                  "NONO_PROXY_TOKEN"
                ],
                "set_vars": {
                  "GH_CONFIG_DIR": "/tmp/nono-gh-config",
                  "GH_PROMPT_DISABLED": "1",
                  "GH_NO_UPDATE_NOTIFIER": "1"
                }
              }
            },
            "invocation_policy": {
              "default": "deny",
              "deny": [
                {
                  "argv": {
                    "prefix": [
                      "pr",
                      "merge"
                    ]
                  },
                  "reason": "the reviewer may comment but not merge"
                },
                {
                  "argv": {
                    "contains": [
                      "graphql"
                    ]
                  },
                  "reason": "direct GraphQL calls are outside the reviewer role"
                }
              ],
              "allow": [
                {
                  "argv": {
                    "prefix": [
                      "api"
                    ]
                  },
                  "reason": "REST only: endpoint policy constrains method and path, and GraphQL is unavailable"
                }
              ]
            }
          }
        }
      }
    }
  }
}
