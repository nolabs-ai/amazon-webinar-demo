{
  "meta": {
    "name": "webinar-developer",
    "version": "0.1.0",
    "description": "Linux policy scaffold for the webinar developer agent"
  },
  "workdir": {
    "access": "readwrite"
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "filesystem": {
    "allow": [
      "$HOME/.pi/developer"
    ],
    "read_file": [
      "/demo/bin/pi-agent"
    ]
  },
  "network": {
    "allow_domain": [
      "nono-deny-all.invalid"
    ],
    "credentials": [
      "llm"
    ],
    "custom_credentials": {
      "llm": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "file:///run/secrets/github/model-api-key",
        "env_var": "LLM_API_KEY",
        "inject_header": "x-api-key",
        "credential_format": "{}",
        "endpoint_rules": [
          {
            "method": "POST",
            "path": "/v1/messages"
          },
          {
            "method": "POST",
            "path": "/v1/messages/count_tokens"
          }
        ]
      }
    }
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "LANG",
      "LC_*",
      "TERM",
      "AGENT_COMMAND",
      "MODEL_PROVIDER",
      "MODEL_ID",
      "MODEL_API",
      "MODEL_AUTH"
    ],
    "set_vars": {
      "PI_CODING_AGENT_DIR": "$HOME/.pi/developer",
      "PI_OFFLINE": "1",
      "PI_SKIP_VERSION_CHECK": "1",
      "PI_TELEMETRY": "0"
    }
  },
  "command_policies": {
    "credentials": {
      "github-api": {
        "type": "proxy",
        "upstream": "https://api.github.com",
        "credential_key": "file:///run/secrets/github/token",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "ssh-agent": {
        "type": "local-socket",
        "path": "$SSH_AUTH_SOCK",
        "mode": "connect",
        "env_var": "SSH_AUTH_SOCK"
      }
    },
    "commands": {
      "git": {
        "executable": "/usr/bin/git",
        "can_use": [
          "ssh"
        ],
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                ".",
                "/usr/lib/git-core"
              ],
              "fs_write": [
                "."
              ],
              "fs_read_file": [
                "/usr/bin/git",
                "@git:config-files"
              ],
              "exec_paths": [
                "/usr/lib/git-core"
              ],
              "network": {
                "allow_all": true
              },
              "environment": {
                "allow_vars": [
                  "PATH",
                  "HOME",
                  "LANG",
                  "LC_*",
                  "TERM"
                ]
              }
            },
            "invocation_policy": {
              "default": "deny",
              "allow": [
                {
                  "argv": {
                    "prefix": [
                      "status"
                    ]
                  },
                  "reason": "the developer may inspect repository status"
                },
                {
                  "argv": {
                    "prefix": [
                      "diff"
                    ]
                  },
                  "reason": "the developer may inspect changes"
                },
                {
                  "argv": {
                    "prefix": [
                      "add"
                    ]
                  },
                  "reason": "the developer may stage the fix"
                },
                {
                  "argv": {
                    "prefix": [
                      "commit"
                    ]
                  },
                  "reason": "the developer may commit the fix"
                },
                {
                  "argv": {
                    "exact": [
                      "switch",
                      "-c",
                      "demo/webinar-fix"
                    ]
                  },
                  "reason": "the developer may create only the demo branch"
                },
                {
                  "argv": {
                    "exact": [
                      "push",
                      "demo-secure",
                      "HEAD:refs/heads/demo/webinar-fix"
                    ]
                  },
                  "reason": "the developer may push only the demo branch"
                }
              ]
            }
          }
        }
      },
      "ssh": {
        "executable": "/usr/bin/ssh",
        "from": {
          "git": {
            "sandbox": {
              "fs_read_file": [
                "/usr/bin/ssh",
                "/etc/nono/github_known_hosts"
              ],
              "use_credentials": [
                "ssh-agent"
              ],
              "network": {
                "allow_all": true
              },
              "environment": {
                "allow_vars": [
                  "PATH",
                  "HOME",
                  "LANG",
                  "LC_*",
                  "TERM",
                  "SSH_AUTH_SOCK"
                ]
              },
              "argv_prepend": [
                "-F",
                "/dev/null",
                "-o",
                "BatchMode=yes",
                "-o",
                "PasswordAuthentication=no",
                "-o",
                "KbdInteractiveAuthentication=no",
                "-o",
                "StrictHostKeyChecking=yes",
                "-o",
                "UserKnownHostsFile=/etc/nono/github_known_hosts",
                "-o",
                "GlobalKnownHostsFile=/dev/null",
                "-o",
                "ClearAllForwardings=yes",
                "-o",
                "RequestTTY=no"
              ]
            },
            "invocation_policy": {
              "default": "deny",
              "allow": [
                {
                  "argv": {
                    "exact": [
                      "-G",
                      "-p",
                      "443",
                      "git@ssh.github.com"
                    ]
                  },
                  "reason": "git may inspect the pinned GitHub SSH transport"
                },
                {
                  "argv": {
                    "exact": [
                      "-p",
                      "443",
                      "git@ssh.github.com",
                      "git-receive-pack '/nolabs-ai/amazon-webinar-demo.git'"
                    ]
                  },
                  "reason": "git may push only to the webinar repository"
                }
              ]
            }
          }
        }
      },
      "gh": {
        "executable": "/usr/bin/gh",
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                "."
              ],
              "fs_write": [
                "/tmp"
              ],
              "fs_read_file": [
                "/usr/bin/gh"
              ],
              "credentials": [
                {
                  "name": "github-api",
                  "endpoint_policy": {
                    "default": "deny",
                    "deny": [
                      {
                        "method": "PUT",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/pulls/*/merge",
                        "reason": "the developer may not merge pull requests"
                      },
                      {
                        "method": "DELETE",
                        "path": "/**",
                        "reason": "the developer may not delete GitHub resources"
                      },
                      {
                        "method": "*",
                        "path": "/graphql",
                        "reason": "the developer may not use GraphQL: nono cannot restrict its operations, so a mutation could merge"
                      }
                    ],
                    "allow": [
                      {
                        "method": "GET",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/issues/**"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/pulls/**"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/commits/**"
                      },
                      {
                        "method": "POST",
                        "path": "/repos/nolabs-ai/amazon-webinar-demo/pulls"
                      }
                    ]
                  }
                }
              ],
              "environment": {
                "allow_vars": [
                  "PATH",
                  "HOME",
                  "LANG",
                  "LC_*",
                  "TERM",
                  "GH_TOKEN",
                  "HTTP_PROXY",
                  "HTTPS_PROXY",
                  "NO_PROXY",
                  "http_proxy",
                  "https_proxy",
                  "no_proxy",
                  "NONO_PROXY_TOKEN"
                ],
                "set_vars": {
                  "GH_CONFIG_DIR": "/tmp/nono-gh-config",
                  "GH_PROMPT_DISABLED": "1",
                  "GH_NO_UPDATE_NOTIFIER": "1"
                }
              }
            },
            "invocation_policy": {
              "default": "deny",
              "deny": [
                {
                  "argv": {
                    "prefix": [
                      "pr",
                      "merge"
                    ]
                  },
                  "reason": "the developer may open a pull request but not merge it"
                },
                {
                  "argv": {
                    "contains": [
                      "graphql"
                    ]
                  },
                  "reason": "direct GraphQL calls are outside the developer role"
                }
              ],
              "allow": [
                {
                  "argv": {
                    "prefix": [
                      "api"
                    ]
                  },
                  "reason": "REST only: endpoint policy constrains method and path, and GraphQL is unavailable"
                }
              ]
            }
          }
        }
      }
    }
  }
}
