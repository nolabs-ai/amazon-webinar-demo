# Fixed values for the webinar run. scripts/run-webinar.sh sources this file;
# any variable already set in the environment wins, so a rehearsal can try
# another model without editing the file:
#   MODEL_ID=... scripts/run-webinar.sh
WEBINAR_REPO=${WEBINAR_REPO:-MateSaary/webinar-demo-sandbox}
WEBINAR_ISSUE=${WEBINAR_ISSUE:-1}
MODEL_PROVIDER=${MODEL_PROVIDER:-anthropic}
MODEL_ID=${MODEL_ID:-claude-sonnet-5-5}
MODEL_API=${MODEL_API:-anthropic-messages}
MODEL_UPSTREAM_URL=${MODEL_UPSTREAM_URL:-https://api.anthropic.com}
STAGE_PAUSE=${STAGE_PAUSE:-0}

# Used by scripts/check-ready.sh to confirm it is looking at the right place.
WEBINAR_AWS_ACCOUNT=${WEBINAR_AWS_ACCOUNT:-816301968846}
WEBINAR_REGION=${WEBINAR_REGION:-eu-west-1}
WEBINAR_CLUSTER=${WEBINAR_CLUSTER:-webinar-kata}
WEBINAR_ECR_REPOSITORY=${WEBINAR_ECR_REPOSITORY:-amazon-webinar-demo}
WEBINAR_NODEGROUP=${WEBINAR_NODEGROUP:-kata}
